{
  "categoryDefaults": {
    "ai": ["ai", "machine-learning"],
    "algorithm": ["algorithm", "problem-solving"],
    "cs": ["computer-science"],
    "javascript": ["javascript", "web"],
    "project": ["project"],
    "investment-journal": ["investment", "journal"],
    "investment-strategy": ["investment", "strategy"],
    "economy-note": ["economy", "market-note"],
    "experience": ["experience"],
    "hobby": ["hobby"],
