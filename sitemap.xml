---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
{% assign site_base = site.url | append: site.baseurl %}
{% for post in site.posts %}
  <url>
    <loc>{{ site_base }}{{ post.url | xml_escape }}</loc>
    {% if post.lastmod %}
    <lastmod>{{ post.lastmod | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
{% endfor %}
{% for page in site.pages %}
  {% assign is_core_page = false %}
  {% if page.url == "/" or page.url == "/profile/" or page.url == "/site-map/" %}
    {% assign is_core_page = true %}
  {% elsif page.url and page.url contains "/categories/" %}
    {% assign is_core_page = true %}
  {% endif %}
  {% if is_core_page and page.sitemap != false and page.url != "/sitemap.xml" and page.url != "/sitemap_index.xml" %}
  <url>
    <loc>{{ site_base }}{{ page.url | xml_escape }}</loc>
    {% if page.lastmod %}
    <lastmod>{{ page.lastmod | date_to_xmlschema }}</lastmod>
    {% elsif page.date %}
    <lastmod>{{ page.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
  {% endif %}
{% endfor %}
</urlset>
